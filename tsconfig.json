{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "public/pagefind",
    "playwright-report",
    "test-results",
    "lighthouse-reports",
    ".lighthouseci",
    "reports"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "types": ["astro/client", "node"]
  }
}
